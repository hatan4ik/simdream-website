{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.staging)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +HEAD:main:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push origin refs/heads/main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-commit.sh" }
        ]
      }
    ]
  }
}
