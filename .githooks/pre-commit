#!/usr/bin/env bash
# Tracked git hook (core.hooksPath = .githooks, set by `npm install` via the prepare script).
# AGENTS.md section 0: never work on main; no secrets in commits.
# Bypass for a real emergency: the --no-verify flag of the commit command.
branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Blocked: committing on main. Cut a branch: git fetch origin && git switch -c devel/<topic> origin/main (AGENTS.md section 0)." >&2
  exit 1
fi
# Environment files hold secrets; .env.example is the only one that belongs in git.
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -Ev '(^|/)\.env\.example$')
if [ -n "$bad" ]; then
  echo "Blocked: staged environment file(s) (secrets never enter the repo, .env.example documents variables):" >&2
  echo "$bad" >&2
  exit 1
fi
exit 0
