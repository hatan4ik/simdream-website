{
  "name": "simdream-website",
  "version": "1.37.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "ALLOW_IN_MEMORY_STORE=true next start",
    "docs:verify": "tsx scripts/check-genesis-coverage.ts --require GENESIS.md",
    "docs:genesis": "npm run docs:verify",
    "docs:genesis:stamp": "tsx scripts/check-genesis-coverage.ts --stamp GENESIS.md",
    "releases:generate": "tsx scripts/release-ledger.ts",
    "releases:verify": "tsx scripts/release-ledger.ts --check",
    "llms:generate": "tsx scripts/generate-llms-txt.ts",
    "preview": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && tsx scripts/check-type-hygiene.ts",
    "check:unused-exports": "tsx scripts/check-unused-exports.ts",
    "test": "vitest run",
    "test:all": "tsx scripts/test-all.ts",
    "test:quick": "tsx scripts/test-all.ts --quick",
    "test:full": "tsx scripts/test-all.ts --full --lighthouse",
    "test:report": "tsx scripts/test-all.ts --report-only",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security && playwright test --project=security-web",
    "test:reliability": "vitest run --project reliability && playwright test --project=resilience",
    "test:coverage": "vitest run --coverage",
    "test:build": "tsx scripts/run-sandboxed.ts next build",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:a11y": "playwright test --project=a11y",
    "test:a11y:baseline": "A11Y_BASELINE_UPDATE=1 playwright test --project=a11y; tsx tests/a11y/update-a11y-baseline.ts",
    "test:usability": "playwright test --project=usability",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "bash scripts/update-visual-baselines.sh",
    "test:load": "tsx scripts/with-server.ts --port 3804 -- tsx tests/load/smoke.ts",
    "test:lighthouse": "tsx scripts/with-server.ts --port 3805 -- tsx tests/perf/run-lighthouse.ts",
    "status": "node scripts/session-status.mjs",
    "test:staging:purchases": "node scripts/verify-staging-purchases.mjs",
    "test:staging:content": "node scripts/verify-staging-content.mjs",
    "test:staging:content:docker": "docker run --rm -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.65.1-noble node scripts/verify-staging-content.mjs",
    "test:staging:docker": "docker run --rm -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.65.1-noble node scripts/verify-staging-purchases.mjs",
    "wix:smoke": "tsx scripts/wix-smoke.ts",
    "wix:blog:migrate": "tsx scripts/migrate-wix-blog.ts",
    "crm:migrate": "tsx tools/crm-migration/cli.ts",
    "wix:blog:translate": "tsx scripts/translate-wix-blog.ts",
    "wix:readiness": "tsx scripts/wix-readiness.ts",
    "wix:check-benefit-pools": "tsx scripts/check-wix-benefit-pools.ts",
    "wix:check-blog-languages": "tsx scripts/check-wix-blog-languages.ts",
    "wix:provision": "tsx scripts/wix-provision.ts",
    "wix:build": "opennextjs-cloudflare build && node scripts/prepare-opennext-for-wix.mjs && wrangler deploy --dry-run --outdir .wix-worker && node scripts/prepare-wix-worker.mjs",
    "wix:preview": "opennextjs-cloudflare preview",
    "wix:release": "npm run wix:build && CI=1 npx --yes @wix/cli@1.2.9 release",
    "verify:dependency-uplift": "npm ci && npm audit --audit-level=moderate && npm install-scripts ls && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:build && npm run wix:build && npm run docs:verify",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.3",
    "@stripe/stripe-js": "^10.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@wix/members": "^1.0.544",
    "@wix/pricing-plans": "^1.0.453",
    "@wix/redirects": "^1.0.134",
    "@wix/sdk": "^1.21.19",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.65.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autocannon": "^9.0.0",
    "fast-check": "^4.11.0",
    "postcss": "^8.5.33",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@wix/members": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@node-minify/core": {
      "glob": "14.0.6"
    },
    "@opennextjs/cloudflare": {
      "glob": "14.0.6"
    },
    "i18next": "26.3.4",
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true,
    "rclone.js": false,
    "fsevents": false
  }
}
