{
  "name": "simdream-website",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "ALLOW_IN_MEMORY_STORE=true next start",
    "docs:verify": "tsx scripts/check-genesis-coverage.ts --require GENESIS.md",
    "docs:genesis": "npm run docs:verify",
    "docs:genesis:stamp": "tsx scripts/check-genesis-coverage.ts --stamp GENESIS.md",
    "preview": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && tsx scripts/check-type-hygiene.ts",
    "test": "vitest run",
    "test:all": "tsx scripts/test-all.ts",
    "test:quick": "tsx scripts/test-all.ts --quick",
    "test:full": "tsx scripts/test-all.ts --full --lighthouse",
    "test:report": "tsx scripts/test-all.ts --report-only",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security && playwright test --project=security-web",
    "test:reliability": "vitest run --project reliability && playwright test --project=resilience",
    "test:coverage": "vitest run --coverage",
    "test:build": "tsx scripts/run-sandboxed.ts next build",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:a11y": "playwright test --project=a11y",
    "test:a11y:baseline": "A11Y_BASELINE_UPDATE=1 playwright test --project=a11y; tsx tests/a11y/update-a11y-baseline.ts",
    "test:usability": "playwright test --project=usability",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "bash scripts/update-visual-baselines.sh",
    "test:load": "tsx scripts/with-server.ts --port 3804 -- tsx tests/load/smoke.ts",
    "test:lighthouse": "tsx scripts/with-server.ts --port 3805 -- tsx tests/perf/run-lighthouse.ts",
    "wix:smoke": "tsx scripts/wix-smoke.ts",
    "wix:readiness": "tsx scripts/wix-readiness.ts",
    "wix:provision": "tsx scripts/wix-provision.ts",
    "wix:build": "opennextjs-cloudflare build && node scripts/prepare-opennext-for-wix.mjs && wrangler deploy --dry-run --outdir .wix-worker && node scripts/prepare-wix-worker.mjs",
    "wix:preview": "opennextjs-cloudflare preview",
    "wix:release": "npm run wix:build && CI=1 npx --yes @wix/cli@1.2.9 release"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.3",
    "@stripe/stripe-js": "^4.8.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@wix/members": "^1.0.541",
    "@wix/pricing-plans": "^1.0.440",
    "@wix/redirects": "^1.0.133",
    "@wix/sdk": "^1.21.18",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^17.2.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "autocannon": "^8.0.0",
    "fast-check": "^4.10.2",
    "postcss": "^8.4.47",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  }
}
