/.next/
/.next-*/
/out/
/build
/.open-next/
/.wix-worker/
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# environment files (keep intentionally non-secret templates tracked)
.env*
!.env.example
!.env.*.example
.envrc

