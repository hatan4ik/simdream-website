*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.ovpn
*.secret
*.secrets
credentials.json
service-account.json
.npmrc

# testing
/coverage

# deployment
.vercel

# local tooling caches
.eslintcache
.swc/
.turbo/
/playwright/.cache/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor clutter
.DS_Store

# test artifacts
/test-results/
/playwright-report*/
/blob-report/

# agent skills installed per machine by `npx skills add <owner>/<repo>` (e.g. wix/skills).
# The CLI writes a copy into every agent's dot folder it detects plus a lockfile;
# none of it is project source. `.github/` itself stays tracked (only its skills copy is ignored).
/skills-lock.json
/.agents/
/.*/skills/
/.claude/
/.codex/
/.codestudio/
/.commandcode/
/.cursor/
/.gemini/
/.grok/
/.inferencesh/
/.kiro/
/.opencode/
/.windsurf/
