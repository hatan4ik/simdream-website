# dependencies
/node_modules

# next.js build output
/.next/
/.next-*/
/out/
/build
/.open-next/
/.wix-worker/
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# environment files (keep the template tracked)
.env
.env*.local
!.env.example

# testing
/coverage

# deployment
.vercel

# local tooling caches
.eslintcache
.swc/
.turbo/
/playwright/.cache/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor clutter
.DS_Store
*.pem

# test artifacts
/test-results/
/playwright-report*/
/blob-report/

# agent skills installed per machine by `npx skills add <owner>/<repo>` (e.g. wix/skills).
# The CLI writes a copy into every agent's dot folder it detects plus a lockfile;
# none of it is project source. `.github/` itself stays tracked (only its skills copy is ignored).
/skills-lock.json
/.agents/
/.*/skills/
/.claude/
/.codex/
/.codestudio/
/.commandcode/
/.cursor/
/.gemini/
/.grok/
/.inferencesh/
/.kiro/
/.opencode/
/.windsurf/
