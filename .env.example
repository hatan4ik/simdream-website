# ==============================================================================
# SIM DREAM LTD - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL & Authentication)
# Obtain these from your Supabase Dashboard: Settings -> API
# OAuth provider client secrets belong in Supabase Auth provider settings, never here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Interim admin access (HTTP Basic auth on /admin and admin API methods)
# Admin access is disabled (503) until both are set. Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=

# Stripe (Card Payments & Webhooks)
# Online booking and voucher sales stay disabled (503) until BOTH the secret key
# and a real webhook signing secret are configured.
# Obtain these from your Stripe Dashboard: Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Transactional Confirmation Emails)
# Obtain from SendGrid Settings -> API Keys
SENDGRID_API_KEY=SG....
NEXT_PUBLIC_SUPPORT_EMAIL=ops@simdream.co.il

# Optional: enables a live 24-hour Google Places review snapshot. Without it,
# the site labels and serves the checked-in local review fallback.
GOOGLE_PLACES_API_KEY=

# Wix Headless business backend (docs/WIX_HEADLESS_ARCHITECTURE.md)
# Both are PUBLIC identifiers: the OAuth client id mints anonymous visitor
# tokens only, and the metasite id names the dedicated SimDream-Staging
# Headless site. Wix-managed builds read those public IDs from wix.config.json.
# The Wix client secret and PayPlus credentials are configured in Wix, never here.
NEXT_PUBLIC_WIX_CLIENT_ID=
WIX_SITE_ID=
# Optional immutable Pricing Plans ids. Set them only after each corresponding
# public Wix plan is approved and published. They are server-only mappings,
# never browser credentials. `npm run wix:readiness` checks all four.
WIX_PLAN_ID_FOUNDATIONS_5X60=
WIX_PLAN_ID_ADVANCED_5X90=
WIX_PLAN_ID_ATPL_10X60=
WIX_PLAN_ID_AIRLINE_10X90=
# Optional safe migration diagnostic. When true, successful local booking
# initializations perform a non-blocking, anonymous read-only comparison with
# Wix Bookings availability. The calendar adapter itself never writes bookings or charges;
# active member subscription redemption opens Wix-hosted Bookings checkout separately.
WIX_SHADOW_READS_ENABLED=false
# Optional Wix-authoritative calendar. When true, the calendar keeps the
# Kantorovich grid and intersects it with current Wix Bookings availability.
# A compatible base-flight checkout reserves through Wix; the local writer is blocked.
WIX_AVAILABILITY_ADAPTER_ENABLED=false
