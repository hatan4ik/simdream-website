# ==============================================================================
# SIM DREAM LTD - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL & Authentication)
# Obtain these from your Supabase Dashboard: Settings -> API
# OAuth provider client secrets belong in Supabase Auth provider settings, never here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Interim admin access (HTTP Basic auth on /admin and admin API methods)
# Admin access is disabled (503) until both are set. Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=

# Stripe (Card Payments & Webhooks)
# Online booking and voucher sales stay disabled (503) until BOTH the secret key
# and a real webhook signing secret are configured.
# Obtain these from your Stripe Dashboard: Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Transactional Confirmation Emails)
# Obtain from SendGrid Settings -> API Keys
SENDGRID_API_KEY=SG....
NEXT_PUBLIC_SUPPORT_EMAIL=ops@simdream.co.il

# Optional: enables a live 24-hour Google Places review snapshot. Without it,
# the site labels and serves the checked-in local review fallback.
GOOGLE_PLACES_API_KEY=
