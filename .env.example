# ==============================================================================
# SIM DREAM LTD - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. `next dev` accepts only loopback origins (127.0.0.1, localhost,
# [::1]) by default. Set to the exact value `true` to also allow LAN devices, .local names,
# tunnels (ngrok, Cloudflare, Tailscale) and this machine's own hostname and addresses, so a
# phone can load the dev server. Any other value keeps it off. Ignored by `next start`.
DEV_ALLOW_REMOTE_ORIGINS=

# Supabase (PostgreSQL & Authentication)
# Obtain these from your Supabase Dashboard: Settings -> API
# OAuth provider client secrets belong in Supabase Auth provider settings, never here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Interim admin access (HTTP Basic auth on /admin and admin API methods)
# Admin access is disabled (503) until both are set. Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=

# Rate limiting: the one request header that carries the client address (SECURITY.md,
# "Client address for rate limiting"). Name the header your edge overwrites or appends:
# cf-connecting-ip, x-vercel-forwarded-for, x-real-ip or x-forwarded-for; any other value
# counts as unset. Unset: x-vercel-forwarded-for when VERCEL=1, otherwise x-forwarded-for.
RATE_LIMIT_CLIENT_IP_HEADER=
# Set to 1 only while finding out which header to name above (SECURITY.md, "Finding the header on a
# host"): it enables GET /api/diagnostics/client-address, which reports which forwarding headers
# arrive, never their values. Any other value, or unset, keeps that route a 404.
CLIENT_ADDRESS_DIAGNOSTIC=
# For x-forwarded-for only: how many trusted proxies append to it, counted from the right
# (integer 1-5, default 1 = the rightmost entry). Other values count as unset.
RATE_LIMIT_TRUSTED_PROXY_HOPS=

# Stripe (Card Payments & Webhooks)
# Online booking and voucher sales stay disabled (503) until BOTH the secret key
# and a real webhook signing secret are configured.
# Obtain these from your Stripe Dashboard: Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Transactional Confirmation Emails)
# Obtain from SendGrid Settings -> API Keys
SENDGRID_API_KEY=SG....
NEXT_PUBLIC_SUPPORT_EMAIL=ops@simdream.co.il
# Optional: the inbox that receives Dispatch inquiries from /contact. Defaults
# to the facility desk address. This is server-only; never expose it to the browser.
CONTACT_INQUIRY_RECIPIENT=
# Optional: the inbox that receives new refund requests from the unlisted /refund form
# (POST /api/refund-requests). Defaults to the desk address in lib/config/facility-info.ts.
REFUND_NOTIFY_EMAIL=

# Optional: lets POST /api/reviews/refresh read the newest Google reviews (legacy
# Place Details, reviews_sort=newest) into the stored snapshot that /api/reviews
# serves. Visitors never trigger a Google call. Without it the bar shows the
# labelled last-known rating and no review texts.
GOOGLE_PLACES_API_KEY=
# Optional dedicated Google Cloud Translation Basic v2 key. When unset, the
# Places key is used for review translations as well. Enable Cloud Translation
# API and restrict this key to the required Google APIs.
GOOGLE_TRANSLATE_API_KEY=
# Shared secret (32+ random characters) that .github/workflows/google-reviews-snapshot.yml
# presents as a Bearer token at 06:00 and 17:00 Israel time. Set the same value as the
# GitHub repository secret and on the Wix site (`wix env set REVIEWS_REFRESH_TOKEN`);
# the route answers 503 until it exists and 401 to any other caller.
REVIEWS_REFRESH_TOKEN=

# Wix Headless business backend (docs/WIX_HEADLESS_ARCHITECTURE.md)
# Both are PUBLIC identifiers: the OAuth client id mints anonymous visitor
# tokens only, and the metasite id names the dedicated SimDream-Staging
# Headless site. Wix-managed builds read those public IDs from wix.config.json.
# The Wix client secret and PayPlus credentials are configured in Wix, never here.
NEXT_PUBLIC_WIX_CLIENT_ID=
WIX_SITE_ID=
# Optional Wix Bookings service UUID for the 120-minute consumer package (`pkg-grand-120`, ₪1,200).
# Leave blank until provisioned on SimDream-Staging via `npm run wix:provision`.
# Set `NEXT_PUBLIC_WIX_SERVICE_ID_GRAND_120` to the same public UUID so browser checkout resolves it too.
WIX_SERVICE_ID_GRAND_120=
NEXT_PUBLIC_WIX_SERVICE_ID_GRAND_120=
# Optional immutable Pricing Plans ids. Set them only after each corresponding
# public Wix plan is approved and published. They are server-only mappings,
# never browser credentials. `npm run wix:readiness` resolves all six plan
# mappings and must pass against the intended staging configuration.
WIX_PLAN_ID_FOUNDATIONS_5X60=
WIX_PLAN_ID_ADVANCED_5X90=
WIX_PLAN_ID_ATPL_10X60=
WIX_PLAN_ID_AIRLINE_10X90=
WIX_PLAN_ID_PRO_3X90=
WIX_PLAN_ID_PRO_5X60=
# Optional safe migration diagnostic. When true, successful local booking
# initializations perform a non-blocking, anonymous read-only comparison with
# Wix Bookings availability. The calendar adapter itself never writes bookings or charges;
# active member subscription redemption opens Wix-hosted Bookings checkout separately.
WIX_SHADOW_READS_ENABLED=false
# Optional Wix-authoritative calendar. When true, the calendar keeps the
# Kantorovich grid and intersects it with current Wix Bookings availability.
# A compatible base-flight checkout reserves through Wix; the local writer is blocked.
WIX_AVAILABILITY_ADAPTER_ENABLED=false
# Wix Bookings Pricing Integration provider for the birthday offer. Keep disabled
# until the separate Custom App extension and its custom booking form field are
# installed on SimDream-Staging; see docs/WIX_BIRTHDAY_PRICING_PROVIDER.md.
WIX_BIRTHDAY_PRICING_PROVIDER_ENABLED=false
WIX_BIRTHDAY_CLAIM_FIELD_ID=
WIX_BIRTHDAY_CLAIM_SECRET=
WIX_BIRTHDAY_PRICING_PROVIDER_APP_ID=
WIX_BIRTHDAY_PRICING_PROVIDER_PUBLIC_KEY=

# Consent controls. Keep the Wix synchronization adapter off until its Wix
# consent-policy configuration has been verified in the target environment.
NEXT_PUBLIC_CONSENT_CATEGORIES_IN_USE=
NEXT_PUBLIC_CONSENT_WIX_SYNC=false

# Operator-only Wix provisioning credentials are deliberately omitted. Do not
# place WIX_ADMIN_API_KEY or WIX_PROVISION_ALLOW_APPLY in a committed env file.
